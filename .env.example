# ¿Quién Gana? — configuración de entorno (ejemplo)
# Copiar a .env para ajustar la URL pública y otros ajustes.
# El sitio estático no necesita ninguna clave: todas las APIs usadas son públicas y gratuitas.

# URL pública para sitemap/canonical/og (sin barra final).
# GitHub Pages de proyecto: https://<usuario>.github.io/<Repo>/
SITE_URL=https://jedahee.github.io/Quien-Gana

# Marca de datos de prueba. En producción DEBE ser false.
# Si algún dataset tiene "mock": true, la web mostrará un aviso visible.
MOCK_DATA=false

# User-Agent para los collectors
COLLECTOR_UA=quien-gana/0.1

# Frecuencias sugeridas de actualización (cron)
CRON_DAILY=0 6 * * *
CRON_MONTHLY=0 7 1 * *
